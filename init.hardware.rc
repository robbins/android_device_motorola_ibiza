#on early-init
#    loglevel 7
#    setprop sys.init_log_level 7
#    write /proc/sys/kernel/printk 7

on init
    # For correctly mounting partitions
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

on fs
    # Mount partitions early (UDC)
    mount_all /vendor/etc/fstab.qcom --early

on post-fs
    write /metadata/postfs.txt ONPOSTFS

on late-fs
    # Wait for hwservicemanager and then mount late (userdata is latemount)
    wait_for_prop hwservicemanager.ready true
    mount_all /vendor/etc/fstab.qcom --late

on post-fs-data
    write /metadata/postfs-data.txt ONPOSTFS-DATA

service logger /system/bin/logcat -b all -D -f /metadata/boot_log.txt
    class main
    user root
    group root system
    disabled
    oneshot

on post-fs
    start logger
